# Copy to .env. Every value has a working default for local development.

PORT=8080
PUBLIC_BASE_URL=http://localhost:8080   # what goes into links and the QR code
DEMO_MODE=true                          # serves the console's API key at /demo/config; false in production

# Auth
API_KEYS=demo:demo-key                  # tenant:key[,tenant:key...]  (one per ERP environment)
DOWNLOAD_TOKEN_SECRET=change-me         # HMAC for signed download links
WEBHOOK_SECRET=change-me                # HMAC for callbacks to the ERP
# SIGNING_PRIVATE_KEY_PEM=              # Ed25519 PKCS8 PEM (from Secrets Manager). Dev: auto-generated in data/keys

# Redis (dedicated to this service, maxmemory-policy noeviction)
REDIS_URL=redis://127.0.0.1:6379/0

# Rendering
# PUPPETEER_EXECUTABLE_PATH=            # only if not using Puppeteer's managed chrome-headless-shell
PUPPETEER_HEADLESS=shell
POOL_SIZE=2                             # render slots per worker (~= vCPUs)
BULK_CONCURRENCY=1                      # slots bulk may use; the rest are kept for single requests
HEAVY_ROW_THRESHOLD=300                 # above this many line items: chunked "heavy lane"
CHUNK_ROWS=250
HEAVY_CONCURRENCY=1
BROWSER_RSS_LIMIT_MB=1200               # recycle Chromium above this
MAX_RENDERS_PER_BROWSER=500

# Admission control
MAX_QUEUE_WAIT_SEC=4                    # refuse singles whose estimated queue wait exceeds this
MIN_INTERACTIVE_BACKLOG=40
MAX_INTERACTIVE_BACKLOG=2000
MAX_ACTIVE_BULK_PER_TENANT=3
SINGLE_WAIT_MS=4000

# Storage
STORAGE_DRIVER=local                    # local | s3
# S3_BUCKET=erp-pdf-archive             # bucket created WITH Object Lock enabled
# AWS_REGION=ap-south-1
ARCHIVE_RETENTION_DAYS=2920
ZIP_PART_MAX_MB=25
