<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><title>Tax Invoice {{number}} [ref {{ctx.docKey}}]</title><style>{{{css}}}</style></head>
<body>
{{#if chunk.isFirst}}
<header class="doc-head">
  <div class="brand">
    <div class="logo">{{initials seller.name}}</div>
    <div>
      <h1>{{seller.name}}</h1>
      <p>{{lines seller.address}}</p>
      <p>GSTIN <b>{{seller.gstin}}</b>{{#if seller.state}} · {{seller.state}}{{#if seller.state_code}} ({{seller.state_code}}){{/if}}{{/if}}</p>
      {{#if seller.phone}}<p>{{seller.phone}}{{#if seller.email}} · {{seller.email}}{{/if}}</p>{{/if}}
    </div>
  </div>
  <div class="doc-title">
    <h2>TAX INVOICE</h2>
    <div class="copy">Original for recipient</div>
    <table class="meta">
      <tr><td>Invoice no.</td><td><b>{{number}}</b></td></tr>
      <tr><td>Invoice date</td><td>{{date date}}</td></tr>
      {{#if due_date}}<tr><td>Due date</td><td>{{date due_date}}</td></tr>{{/if}}
      {{#if po_reference}}<tr><td>Buyer PO</td><td>{{po_reference}}</td></tr>{{/if}}
      <tr><td>Place of supply</td><td>{{place_of_supply}}</td></tr>
      <tr><td>Reverse charge</td><td>{{#if reverse_charge}}Yes{{else}}No{{/if}}</td></tr>
    </table>
  </div>
</header>
{{#if einvoice}}
<p class="small muted" style="margin-top:6px">IRN {{einvoice.irn}} · Ack {{einvoice.ack_no}} · {{date einvoice.ack_date}}</p>
{{/if}}
<section class="parties">
  <div class="party"><h3>Bill to</h3>
    <div class="name">{{buyer.name}}</div><div>{{lines buyer.address}}</div>
    {{#if buyer.gstin}}<div>GSTIN <b>{{buyer.gstin}}</b></div>{{/if}}
    {{#if buyer.state}}<div class="muted">{{buyer.state}}{{#if buyer.state_code}} ({{buyer.state_code}}){{/if}}</div>{{/if}}
  </div>
  <div class="party"><h3>Ship to</h3>
    {{#if ship_to}}<div class="name">{{ship_to.name}}</div><div>{{lines ship_to.address}}</div>{{else}}<div class="muted">Same as billing address</div>{{/if}}
  </div>
  <div class="party"><h3>Supply</h3>
    <div>{{#if intra}}Intra-state · CGST + SGST{{else}}Inter-state · IGST{{/if}}</div>
    <div class="muted">{{chunk.total}} line item{{#if (gt chunk.total 1)}}s{{/if}}</div>
    {{#if payment_terms}}<div class="muted">Terms: {{payment_terms}}</div>{{/if}}
  </div>
</section>
{{else}}
<div class="cont-head"><span><b>Tax Invoice {{number}}</b> · {{seller.name}}</span><span class="muted">continued · items {{chunk.from}}–{{chunk.to}} of {{chunk.total}}</span></div>
{{/if}}

{{> items}}

{{#if chunk.isLast}}
<section class="summary">
  <div>
    <table class="tax">
      <thead><tr><th>GST rate</th><th>Taxable</th>{{#if intra}}<th>CGST</th><th>SGST</th>{{else}}<th>IGST</th>{{/if}}<th>Total tax</th></tr></thead>
      <tbody>
      {{#each taxSummary}}
        <tr><td>{{pct rate}}</td><td>{{money taxable}}</td>{{#if ../intra}}<td>{{money cgst}}</td><td>{{money sgst}}</td>{{else}}<td>{{money igst}}</td>{{/if}}<td>{{money tax}}</td></tr>
      {{/each}}
      </tbody>
    </table>
    <div class="words">{{words totals.grand_total}}</div>
    {{#if bank}}
    <div class="block"><h3>Bank details</h3>
      <div>{{bank.account_name}} · {{bank.name}}</div>
      <div class="muted">A/c {{bank.account_no}} · IFSC {{bank.ifsc}}{{#if bank.branch}} · {{bank.branch}}{{/if}}</div>
    </div>
    {{/if}}
  </div>
  <div>
    <table class="totals">
      <tr><td>Taxable value</td><td>₹ {{money totals.taxable}}</td></tr>
      {{#if intra}}
      <tr><td>CGST</td><td>₹ {{money totals.cgst}}</td></tr>
      <tr><td>SGST</td><td>₹ {{money totals.sgst}}</td></tr>
      {{else}}
      <tr><td>IGST</td><td>₹ {{money totals.igst}}</td></tr>
      {{/if}}
      {{#if totals.round_off}}<tr><td>Round off</td><td>₹ {{money totals.round_off}}</td></tr>{{/if}}
      <tr class="grand"><td>Grand total</td><td>₹ {{money totals.grand_total}}</td></tr>
    </table>
  </div>
</section>
{{#if notes}}<div class="block"><h3>Notes</h3><div>{{lines notes}}</div></div>{{/if}}
{{#if terms}}<div class="block"><h3>Terms &amp; conditions</h3><div class="small muted">{{lines terms}}</div></div>{{/if}}
<section class="foot">
  <div class="verify">
    {{#if qr}}{{qr}}{{/if}}
    <div class="small muted">Scan or visit the link to verify this document has not been altered since it was generated.<br><span class="badge">Tamper-evident</span></div>
  </div>
  <div></div>
  <div class="sign">For <b>{{seller.name}}</b><br><span class="line">Authorised signatory</span></div>
</section>
{{/if}}
</body>
</html>
